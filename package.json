{
  "name": "appforge",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "start:local": "node scripts/run.mjs start --local",
    "dev:local": "node scripts/run.mjs dev --local",
    "e2e": "pnpm --filter @appforge/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
