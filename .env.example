# Everything is optional. With no keys the product runs end to end on demo adapters.
APPFORGE_PUBLIC_URL=http://localhost:3000      # the address users (and their phones) reach; used in share links, emails, checkout returns
POSTGRES_PASSWORD=change-me                    # docker compose only
# DATABASE_URL=postgres://user:pass@host:5432/db   # unset = embedded Postgres in .data/pg (fine for trying it out)

# --- AI generation (otherwise a built-in keyword generator is used) ---
APPFORGE_FLAG_REAL_LLM=false
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Voice input (Whisper-compatible /audio/transcriptions endpoint) ---
APPFORGE_FLAG_REAL_TRANSCRIBE=false
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=

# --- Email (magic links). Unset = links are printed to the server log ---
RESEND_API_KEY=
MAIL_FROM=

# --- Payments: customers pay each app owner directly via Stripe Connect; also platform subscriptions ---
APPFORGE_FLAG_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # one endpoint each: POST /api/v1/webhooks/payments and /api/v1/webhooks/billing
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
APPFORGE_FLAG_PAYPAL=false
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_LIVE=false

# --- Push notifications via Expo Push Service ---
APPFORGE_FLAG_PUSH=false
EXPO_ACCESS_TOKEN=

# --- Store builds via EAS (you also need your own Apple Developer / Google Play accounts configured in EAS) ---
APPFORGE_FLAG_EAS=false
EXPO_TOKEN=

# --- Accounts, keys, operators ---
APPFORGE_SECRET=                # REQUIRED with DATABASE_URL: encrypts users' own AI keys at rest (openssl rand -hex 32). Never change it casually: saved keys become unreadable.
APPFORGE_OPERATOR_EMAILS=       # comma-separated; these verified accounts see /operator (users, usage, block)
