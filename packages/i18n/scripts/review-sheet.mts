// Writes docs/hebrew-review.md: every UI string, English next to Hebrew, for a native speaker to check.
//   pnpm --filter @appforge/i18n review-sheet
import { writeFileSync } from "node:fs";
import path from "node:path";
import { MESSAGES } from "../src/index";

const en = MESSAGES.en as Record<string, string>;
const he = MESSAGES.he as Record<string, string>;
const esc = (s: string) => s.replace(/\|/g, "\\|").replace(/\n/g, " ");
const groups = new Map<string, string[]>();
for (const k of Object.keys(en)) {
  const g = k.split(".")[0]!;
  groups.set(g, [...(groups.get(g) ?? []), `| \`${k}\` | ${esc(en[k]!)} | ${esc(he[k] ?? "")} |  |`]);
}
const out = [
  "# Hebrew copy review",
  "",
  "The Hebrew text in AppForge was written by an AI and has **not** been reviewed by a native speaker. Please read each row, and in the last column write the corrected Hebrew (or leave empty if it is fine). Placeholders like `{plan}` or `{n}` must stay as they are.",
  "",
  `${Object.keys(en).length} strings. Generated by \`pnpm --filter @appforge/i18n review-sheet\`; do not edit the first three columns by hand.`,
  "",
  ...[...groups].flatMap(([g, rows]) => [`## ${g}`, "", "| Key | English | Hebrew now | Correction |", "|---|---|---|---|", ...rows, ""]),
].join("\n");
writeFileSync(path.resolve(import.meta.dirname, "../../../docs/hebrew-review.md"), out);
console.log(`wrote docs/hebrew-review.md (${Object.keys(en).length} strings)`);
